# ============================================
# CoolCache Backend Environment Template
# ============================================
# Copy this file to Backend/.env and fill in values
# ============================================

NODE_ENV=production
PORT=5000

# ============================================
# CRITICAL SECURITY - MUST CONFIGURE
# ============================================

# Admin Credentials
# ⚠️ Use strong, unique values - NEVER use defaults
# Generate strong password: openssl rand -base64 20
ADMIN_USERNAME=your-secure-admin-username
ADMIN_PASSWORD=your-secure-admin-password

# JWT Secret - Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 bytes for production
JWT_SECRET=

# ============================================
# DATABASE
# ============================================

# MongoDB Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
# Get from: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/coolcache

# ============================================
# CORS & SECURITY
# ============================================

# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://www.coolcache.app,https://coolcache.app,https://coolcache.vercel.app

# Rate Limiting
LOGIN_RATE_LIMIT_WINDOW=15
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900000

# ============================================
# FILE UPLOAD
# ============================================

MAX_FILE_SIZE=5242880
MAX_REQUEST_SIZE=50mb
UPLOAD_DIR=./Backend/data/uploads

# ============================================
# EMAIL (Optional)
# ============================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=admin@coolcache.app

# ============================================
# CACHE & SESSION
# ============================================

CACHE_TTL_MS=60000
SESSION_SECRET=your-session-secret-key

# ============================================
# ANALYTICS (Optional)
# ============================================

GA_TRACKING_ID=
LOG_ANALYTICS=true

# ============================================
# IMAGE OPTIMIZATION (Optional)
# ============================================

IMAGE_CDN_URL=
ENABLE_IMAGE_OPTIMIZATION=true
IMAGE_COMPRESSION_QUALITY=80
