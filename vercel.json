{
  "rewrites": [
    {
      "source": "/product/:id",
      "destination": "/api/product-preview?id=:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Instagram|Twitterbot|X-Twitter|TelegramBot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview|pinterest|Pinterestbot).*"
        }
      ]
    },
    {
      "source": "/product/:slug",
      "destination": "/api/product-preview?id=:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Instagram|Twitterbot|X-Twitter|TelegramBot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview|pinterest|Pinterestbot).*"
        }
      ]
    },
    {
      "source": "/((?!assets/|api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ]
}
