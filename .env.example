# Example environment variables for CoolCache
# COPY THIS FILE to .env.local (or set variables in your Vercel dashboard)
# Do NOT commit real secrets. Replace placeholders with production values.

### App / Deployment
NEXT_PUBLIC_APP_URL=https://www.coolcache.app
NEXT_PUBLIC_API_BASE_URL=https://www.coolcache.app
ALLOWED_ORIGINS=https://www.coolcache.app,https://coolcache.app,https://coolcache.vercel.app

# Aliases used in code (kept for compatibility)
# Some files reference NEXT_PUBLIC_API_URL, API_BASE or SITE_URL — keep these as aliases
NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_BASE_URL}
API_BASE=${NEXT_PUBLIC_API_BASE_URL}
SITE_URL=${NEXT_PUBLIC_APP_URL}

### Cloudinary (images)
NEXT_PUBLIC_CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
IMAGE_CDN_URL=https://res.cloudinary.com/your_cloudinary_name/image/upload
NEXT_PUBLIC_IMAGE_BASE_URL=https://res.cloudinary.com/your_cloudinary_name/image/upload
ENABLE_IMAGE_OPTIMIZATION=true
IMAGE_COMPRESSION_QUALITY=80

### Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/coolcache

### Authentication / Admin
JWT_SECRET=replace_with_strong_jwt_secret
SESSION_SECRET=replace_with_session_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_in_production

### Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_public_key
VAPID_PRIVATE_KEY=replace_private_key
VAPID_PUBLIC_KEY=replace_public_key

### Email (SMTP)
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_PASS=your-email-password
ADMIN_EMAILS=admin@coolcache.app,support@coolcache.app

### Analytics / Feature Flags
GA_TRACKING_ID=G-XXXXXXX
LOG_ANALYTICS=false

### Server / Local dev
PORT=5000
NODE_ENV=production
MAX_REQUEST_SIZE=50mb
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./Backend/data/uploads

### Misc
CACHE_TTL_MS=60000
SEARCH_MAX_PAGE_SIZE=48
SEARCH_MAX_TOKENS=6

# Notes:
# - Keep secrets out of the repository. Use environment variables in Vercel
#   (Project Settings > Environment Variables) for production values.
# - Remove or override any variables you don't need for your deployment.