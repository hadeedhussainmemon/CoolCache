# ============================================
# CoolCache Environment Variables
# ============================================
# 
# IMPORTANT: Copy this file to .env or .env.local
# and fill in your actual values before deploying
# ============================================

# ============================================
# FRONTEND (.env.local or .env)
# ============================================

# API Base URL - Backend server address
VITE_API_BASE_URL=http://localhost:5000
# For production: https://api.coolcache.app or https://coolcache.onrender.com

# Enable debug mode for development
VITE_DEBUG=false

# ============================================
# BACKEND (.env in Backend/ directory)
# ============================================

# Server Configuration
NODE_ENV=production
PORT=5000

# MongoDB Connection
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=

# Admin Credentials - CRITICAL SECURITY
# ⚠️ MUST be strong and unique - NEVER use defaults
ADMIN_USERNAME=your-secure-admin-username
ADMIN_PASSWORD=your-secure-admin-password

# JWT Secret - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ MUST be at least 32 bytes - NEVER use "your-secret-key"
JWT_SECRET=

# CORS Allowed Origins - Comma-separated list
ALLOWED_ORIGINS=https://www.coolcache.app,https://coolcache.app,https://coolcache.vercel.app

# Email Configuration (optional - for order notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=

# File Upload Limits
MAX_FILE_SIZE=5242880
MAX_REQUEST_SIZE=50mb

# Rate Limiting
LOGIN_RATE_LIMIT_WINDOW=15
LOGIN_RATE_LIMIT_ATTEMPTS=5

# Cache Settings
CACHE_TTL_MS=60000
SESSION_SECRET=

# Analytics (optional)
GA_TRACKING_ID=

# CDN/Image Optimization
IMAGE_CDN_URL=
ENABLE_IMAGE_OPTIMIZATION=true

# Deployment
VERCEL_URL=
